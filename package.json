{
  "name": "aussie-wh-simulator",
  "version": "2.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "node scripts/dev.cjs",
    "build:web": "expo export --platform web",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "update:preview": "npx eas-cli update --channel preview",
    "update:production": "npx eas-cli update --channel production",
    "release:preview": "node scripts/release-preview.cjs",
    "start:server": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-server.cjs && node scripts/test-api-url.cjs && node scripts/test-game.cjs && node scripts/test-native-audio.cjs && node scripts/test-briefing.cjs && node scripts/test-translation.cjs && node scripts/test-expressions.cjs && node scripts/test-shift-review.cjs && node scripts/test-tts.cjs && node scripts/test-suggestions.cjs && node scripts/test-jev-proxy.cjs && node scripts/test-flashcards.cjs && node scripts/test-vault-dictionary.cjs && node scripts/test-vocabulary-test.cjs && node scripts/test-vocabulary-ui.cjs",
    "voices:generate": "node scripts/generate-arrival-voices.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~51.0.0",
    "expo-av": "~14.0.5",
    "expo-file-system": "~17.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-secure-store": "~13.0.2",
    "expo-speech-recognition": "^0.3.2",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "~0.25.28",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "ws": "^8.18.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
